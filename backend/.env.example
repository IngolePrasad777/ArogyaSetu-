SERVER_PORT=8080

# Database — use localhost + disable for local Docker, RDS endpoint + require for production
RDS_ENDPOINT=localhost
RDS_PORT=5432
RDS_DATABASE=arogyasetu
RDS_USERNAME=postgres
RDS_PASSWORD=postgres
DB_SSL_MODE=disable

# For AWS RDS production, set:
# RDS_ENDPOINT=your-instance.rds.amazonaws.com
# RDS_DATABASE=postgres
# RDS_USERNAME=postgres
# RDS_PASSWORD=your-password
# DB_SSL_MODE=require

JWT_SECRET=replace-with-at-least-64-random-characters-here-use-openssl-rand-base64-64
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=arogyasetu-bucket

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
OTP_ENABLED=false
OTP_EXPIRATION=300000
REDIS_HOST=localhost
REDIS_PORT=6379
